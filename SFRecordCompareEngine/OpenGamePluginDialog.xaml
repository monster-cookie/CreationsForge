<Window x:Class="SFRecordCompareEngine.OpenGamePluginDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Open"
        Height="360"
        Width="640"
        MinHeight="340"
        MinWidth="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.ColumnSpan="3"
                       Text="Plugin"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8" />

            <ComboBox x:Name="PluginComboBox"
                      Grid.Row="1"
                      Height="34"
                      FontSize="12"
                      IsEditable="True"
                      IsTextSearchEnabled="False"
                      VerticalContentAlignment="Center"
                      ItemsSource="{Binding PluginItems}"
                      SelectedItem="{Binding SelectedPluginItem, Mode=TwoWay}"
                      Text="{Binding PluginSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding PluginFileName}"
                                   FontSize="12"
                                   Padding="4,2">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="Black" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                            <Setter Property="Foreground" Value="#B00020" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <Button Grid.Row="1"
                    Grid.Column="1"
                    Content="Load"
                    Width="84"
                    Height="34"
                    Margin="12,0,0,0"
                    Command="{Binding LoadPluginHeaderCommand}" />

            <Button Grid.Row="1"
                    Grid.Column="2"
                    Content="Refresh"
                    Width="84"
                    Height="34"
                    Margin="12,0,0,0"
                    Command="{Binding RefreshPluginsCommand}" />

            <TextBlock x:Name="StatusTextBlock"
                       Grid.Row="2"
                       Grid.ColumnSpan="3"
                       Margin="0,12,0,0"
                       Foreground="#555"
                       TextWrapping="Wrap"
                       Text="{Binding StatusText}" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" FontWeight="SemiBold" Margin="0,0,12,8" />
            <TextBlock x:Name="PluginNameTextBlock" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" TextWrapping="Wrap"
                       Text="{Binding PluginName}" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Author" FontWeight="SemiBold" Margin="0,0,12,8" />
            <TextBlock x:Name="PluginAuthorTextBlock" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" TextWrapping="Wrap"
                       Text="{Binding PluginAuthor}" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Version" FontWeight="SemiBold" Margin="0,0,12,8" />
            <TextBlock x:Name="PluginVersionTextBlock" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8"
                       TextWrapping="Wrap"
                       Text="{Binding PluginVersion}" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Description" FontWeight="SemiBold" Margin="0,0,12,8" />
            <TextBlock x:Name="PluginDescriptionTextBlock" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8"
                       TextWrapping="Wrap"
                       Text="{Binding PluginDescription}" />

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Masters" FontWeight="SemiBold" Margin="0,0,12,0" />
            <TextBlock x:Name="PluginMastersTextBlock" Grid.Row="4" Grid.Column="1" TextWrapping="Wrap"
                       Text="{Binding PluginMasters}" />
        </Grid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,24,0,0">
            <Button x:Name="OpenButton"
                    Content="Open"
                    Width="84"
                    Height="34"
                    IsDefault="True"
                    IsEnabled="{Binding CanOpen}"
                    Click="OpenButton_Click" />
            <Button Content="Cancel"
                    Width="84"
                    Height="34"
                    Margin="12,0,0,0"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
