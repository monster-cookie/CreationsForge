<?xml version="1.0" encoding="utf-8"?>

<UserControl
    x:Class="SFRecordCompareEngine.Views.MainView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:SFRecordCompareEngine.Converters">
    <UserControl.Resources>
        <converters:ActivePluginColumnBorderBrushConverter x:Key="ActivePluginColumnBorderBrushConverter" />
        <converters:RecordComparisonValueBackgroundBrushConverter x:Key="RecordComparisonValueBackgroundBrushConverter" />
    </UserControl.Resources>
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="620" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid
                Grid.Column="0"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid
                    Grid.Row="0"
                    ColumnSpacing="8"
                    Padding="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBox
                        Grid.Column="0"
                        Header="FormID"
                        PlaceholderText="Filter FormID"
                        Text="{Binding FormIDFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox
                        Grid.Column="1"
                        Header="EditorID"
                        PlaceholderText="Filter EditorID"
                        Text="{Binding EditorIDFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <Grid
                    Grid.Row="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,1"
                    ColumnSpacing="8"
                    Padding="8,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        FontWeight="SemiBold"
                        Text="FormID" />
                    <TextBlock
                        Grid.Column="1"
                        FontWeight="SemiBold"
                        Text="EditorID" />
                </Grid>

                <TreeView
                    x:Name="RecordTree"
                    Grid.Row="2"
                    ItemsSource="{Binding RecordTreeItems}"
                    SelectionChanged="RecordTree_SelectionChanged"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.HorizontalScrollMode="Enabled">
                    <TreeView.ItemTemplate>
                        <DataTemplate>
                            <TreeViewItem ItemsSource="{Binding Children}">
                                <Grid
                                    Width="760"
                                    ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="230" />
                                        <ColumnDefinition Width="522" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Column="0"
                                        Text="{Binding FormIDText}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{Binding EditorID}" />
                                </Grid>
                            </TreeViewItem>
                        </DataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Grid>

            <ScrollViewer
                Grid.Column="1"
                Padding="12"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Enabled">
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.Visibility>
                            <Binding Path="RecordComparisonVisibility" />
                        </Grid.Visibility>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.Column="0"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                            <StackPanel>
                                <Border
                                    Height="48"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="8">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Text="Field" />
                                </Border>
                                <ItemsControl ItemsSource="{Binding RecordComparisonFields}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                Height="32"
                                                Background="{Binding State, Converter={StaticResource RecordComparisonValueBackgroundBrushConverter}}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="0,0,0,1"
                                                Padding="8,4">
                                                <TextBlock Text="{Binding Label}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <ScrollViewer
                            Grid.Column="1"
                            HorizontalScrollBarVisibility="Auto"
                            HorizontalScrollMode="Enabled"
                            VerticalScrollMode="Disabled">
                            <ItemsControl ItemsSource="{Binding RecordComparisonColumns}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Width="280"
                                            BorderBrush="{Binding IsActive, Converter={StaticResource ActivePluginColumnBorderBrushConverter}}"
                                            BorderThickness="2">
                                            <StackPanel>
                                                <Border
                                                    Height="46"
                                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="0,0,1,1"
                                                    Padding="8">
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        FontWeight="SemiBold"
                                                        Text="{Binding HeaderText}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </Border>
                                                <ItemsControl ItemsSource="{Binding Values}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border
                                                                Height="32"
                                                                Background="{Binding State, Converter={StaticResource RecordComparisonValueBackgroundBrushConverter}}"
                                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                BorderThickness="0,0,1,1"
                                                                Padding="8,4">
                                                                <TextBlock
                                                                    Text="{Binding Value}"
                                                                    TextTrimming="CharacterEllipsis" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <Border
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Padding="12">
                        <Border.Visibility>
                            <Binding Path="RecordComparisonGroupsVisibility" />
                        </Border.Visibility>
                        <StackPanel Spacing="8">
                            <ItemsControl ItemsSource="{Binding RecordComparisonGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Expander
                                            Margin="0,0,0,8"
                                            IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                                            <Expander.Header>
                                                <Grid
                                                    ColumnSpacing="10"
                                                    Padding="4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock
                                                        Grid.Column="0"
                                                        VerticalAlignment="Center"
                                                        FontWeight="SemiBold"
                                                        Text="{Binding HeaderText}" />
                                                    <Border
                                                        Grid.Column="1"
                                                        Background="#302D7D46"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        Padding="8,2">
                                                        <TextBlock
                                                            FontSize="12"
                                                            Text="{Binding RowCountText}" />
                                                    </Border>
                                                    <Border
                                                        Grid.Column="2"
                                                        Background="{Binding State, Converter={StaticResource RecordComparisonValueBackgroundBrushConverter}}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        Padding="8,2">
                                                        <TextBlock
                                                            FontSize="12"
                                                            Text="{Binding ChangeStatusText}" />
                                                    </Border>
                                                </Grid>
                                            </Expander.Header>
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="230" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border
                                                        Grid.Column="0"
                                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1,1,0,1"
                                                        Padding="8,6">
                                                        <TextBlock
                                                            FontWeight="SemiBold"
                                                            Text="Property" />
                                                    </Border>

                                                    <ScrollViewer
                                                        Grid.Column="1"
                                                        HorizontalScrollBarVisibility="Auto"
                                                        HorizontalScrollMode="Enabled"
                                                        VerticalScrollMode="Disabled">
                                                        <ItemsControl ItemsSource="{Binding PluginColumns}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border
                                                                        Width="280"
                                                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                                        BorderBrush="{Binding IsActive, Converter={StaticResource ActivePluginColumnBorderBrushConverter}}"
                                                                        BorderThickness="1"
                                                                        Padding="8,6">
                                                                        <TextBlock
                                                                            FontWeight="SemiBold"
                                                                            Text="{Binding HeaderText}"
                                                                            TextTrimming="CharacterEllipsis" />
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                </Grid>

                                                <ItemsControl ItemsSource="{Binding Rows}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="230" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>

                                                                <Border
                                                                    Grid.Column="0"
                                                                    MinHeight="34"
                                                                    Background="{Binding State, Converter={StaticResource RecordComparisonValueBackgroundBrushConverter}}"
                                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                    BorderThickness="1,0,0,1"
                                                                    Padding="8,5">
                                                                    <TextBlock
                                                                        Text="{Binding Label}"
                                                                        TextTrimming="CharacterEllipsis" />
                                                                </Border>

                                                                <ScrollViewer
                                                                    Grid.Column="1"
                                                                    HorizontalScrollBarVisibility="Auto"
                                                                    HorizontalScrollMode="Enabled"
                                                                    VerticalScrollMode="Disabled">
                                                                    <ItemsControl ItemsSource="{Binding Values}">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <StackPanel Orientation="Horizontal" />
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <Border
                                                                                    Width="280"
                                                                                    MinHeight="34"
                                                                                    Background="{Binding State, Converter={StaticResource RecordComparisonValueBackgroundBrushConverter}}"
                                                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                                    BorderThickness="0,0,1,1"
                                                                                    Padding="8,5">
                                                                                    <TextBlock
                                                                                        Text="{Binding Value}"
                                                                                        TextTrimming="CharacterEllipsis" />
                                                                                </Border>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </ScrollViewer>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Padding="12">
                        <Border.Visibility>
                            <Binding Path="RecordComparisonScriptsVisibility" />
                        </Border.Visibility>
                        <StackPanel Spacing="10">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel
                                    Grid.Column="0"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Text="{Binding ScriptingAdapterSectionHeader}" />
                                </StackPanel>

                                <StackPanel
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <Button
                                        Command="{Binding CollapseAllScriptsCommand}"
                                        Content="Collapse all" />
                                    <Button
                                        Command="{Binding ExpandChangedScriptsCommand}"
                                        Content="Expand changed" />
                                    <Button
                                        Command="{Binding ToggleChangedOnlyScriptsCommand}"
                                        Content="{Binding ChangedOnlyScriptsButtonText}" />
                                </StackPanel>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding RecordComparisonScripts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Expander
                                            Margin="0,0,0,8"
                                            IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                                            <Expander.Header>
                                                <Grid
                                                    ColumnSpacing="10"
                                                    Padding="4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock
                                                        Grid.Column="0"
                                                        VerticalAlignment="Center"
                                                        FontWeight="SemiBold"
                                                        Text="{Binding HeaderText}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <Border
                                                        Grid.Column="1"
                                                        Background="#302D7D46"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        Padding="8,2">
                                                        <TextBlock
                                                            FontSize="12"
                                                            Text="{Binding PropertyCountText}" />
                                                    </Border>
                                                    <Border
                                                        Grid.Column="2"
                                                        Background="{Binding State, Converter={StaticResource RecordComparisonValueBackgroundBrushConverter}}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        Padding="8,2">
                                                        <TextBlock
                                                            FontSize="12"
                                                            Text="{Binding ChangeStatusText}" />
                                                    </Border>
                                                </Grid>
                                            </Expander.Header>
                                            <StackPanel Spacing="8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="410" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <Grid
                                                        Grid.Column="0"
                                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1,1,0,1">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="120" />
                                                            <ColumnDefinition Width="80" />
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock
                                                            Grid.Column="0"
                                                            Padding="8,6"
                                                            FontWeight="SemiBold"
                                                            Text="Property" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            Padding="8,6"
                                                            FontWeight="SemiBold"
                                                            Text="Type" />
                                                        <TextBlock
                                                            Grid.Column="2"
                                                            Padding="8,6"
                                                            FontWeight="SemiBold"
                                                            Text="List" />
                                                    </Grid>

                                                    <ScrollViewer
                                                        Grid.Column="1"
                                                        HorizontalScrollBarVisibility="Auto"
                                                        HorizontalScrollMode="Enabled"
                                                        VerticalScrollMode="Disabled">
                                                        <ItemsControl ItemsSource="{Binding PluginColumns}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border
                                                                        Width="280"
                                                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                                        BorderBrush="{Binding IsActive, Converter={StaticResource ActivePluginColumnBorderBrushConverter}}"
                                                                        BorderThickness="1">
                                                                        <TextBlock
                                                                            Padding="8,6"
                                                                            FontWeight="SemiBold"
                                                                            Text="{Binding HeaderText}"
                                                                            TextTrimming="CharacterEllipsis" />
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                </Grid>

                                                <ItemsControl ItemsSource="{Binding Properties}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="410" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>

                                                                <Grid
                                                                    Grid.Column="0"
                                                                    Height="34"
                                                                    Background="{Binding State, Converter={StaticResource RecordComparisonValueBackgroundBrushConverter}}"
                                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                    BorderThickness="1,0,0,1">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="120" />
                                                                        <ColumnDefinition Width="80" />
                                                                    </Grid.ColumnDefinitions>

                                                                    <TextBlock
                                                                        Grid.Column="0"
                                                                        Padding="8,5"
                                                                        Text="{Binding Label}"
                                                                        TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock
                                                                        Grid.Column="1"
                                                                        Padding="8,5"
                                                                        Text="{Binding Type}"
                                                                        TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock
                                                                        Grid.Column="2"
                                                                        Padding="8,5"
                                                                        Text="{Binding ListCount}"
                                                                        TextTrimming="CharacterEllipsis" />
                                                                </Grid>

                                                                <ScrollViewer
                                                                    Grid.Column="1"
                                                                    HorizontalScrollBarVisibility="Auto"
                                                                    HorizontalScrollMode="Enabled"
                                                                    VerticalScrollMode="Disabled">
                                                                    <ItemsControl ItemsSource="{Binding Values}">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <StackPanel Orientation="Horizontal" />
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <Border
                                                                                    Width="280"
                                                                                    Height="34"
                                                                                    Background="{Binding State, Converter={StaticResource RecordComparisonValueBackgroundBrushConverter}}"
                                                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                                    BorderThickness="0,0,1,1"
                                                                                    Padding="8,5">
                                                                                    <TextBlock
                                                                                        Text="{Binding Value}"
                                                                                        TextTrimming="CharacterEllipsis" />
                                                                                </Border>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </ScrollViewer>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Padding="12">
                        <Border.Visibility>
                            <Binding Path="RecordComparisonPerkRanksVisibility" />
                        </Border.Visibility>
                        <StackPanel Spacing="10">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Text="{Binding PerkRankSectionHeader}" />

                                <StackPanel
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <Button
                                        Command="{Binding CollapseAllPerkRanksCommand}"
                                        Content="Collapse all" />
                                    <Button
                                        Command="{Binding ExpandChangedPerkRanksCommand}"
                                        Content="Expand changed" />
                                    <Button
                                        Command="{Binding ToggleChangedOnlyPerkRanksCommand}"
                                        Content="{Binding ChangedOnlyPerkRanksButtonText}" />
                                </StackPanel>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding RecordComparisonPerkRanks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Expander
                                            Margin="0,0,0,8"
                                            IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                                            <Expander.Header>
                                                <Grid
                                                    ColumnSpacing="10"
                                                    Padding="4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock
                                                        Grid.Column="0"
                                                        VerticalAlignment="Center"
                                                        FontWeight="SemiBold"
                                                        Text="{Binding HeaderText}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <Border
                                                        Grid.Column="1"
                                                        Background="#302D7D46"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        Padding="8,2">
                                                        <TextBlock
                                                            FontSize="12"
                                                            Text="{Binding RowCountText}" />
                                                    </Border>
                                                    <Border
                                                        Grid.Column="2"
                                                        Background="{Binding State, Converter={StaticResource RecordComparisonValueBackgroundBrushConverter}}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        Padding="8,2">
                                                        <TextBlock
                                                            FontSize="12"
                                                            Text="{Binding ChangeStatusText}" />
                                                    </Border>
                                                </Grid>
                                            </Expander.Header>
                                            <StackPanel Spacing="8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="410" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <Grid
                                                        Grid.Column="0"
                                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1,1,0,1">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="160" />
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock
                                                            Grid.Column="0"
                                                            Padding="8,6"
                                                            FontWeight="SemiBold"
                                                            Text="Row" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            Padding="8,6"
                                                            FontWeight="SemiBold"
                                                            Text="Type" />
                                                    </Grid>

                                                    <ScrollViewer
                                                        Grid.Column="1"
                                                        HorizontalScrollBarVisibility="Auto"
                                                        HorizontalScrollMode="Enabled"
                                                        VerticalScrollMode="Disabled">
                                                        <ItemsControl ItemsSource="{Binding PluginColumns}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border
                                                                        Width="280"
                                                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                                        BorderBrush="{Binding IsActive, Converter={StaticResource ActivePluginColumnBorderBrushConverter}}"
                                                                        BorderThickness="1">
                                                                        <TextBlock
                                                                            Padding="8,6"
                                                                            FontWeight="SemiBold"
                                                                            Text="{Binding HeaderText}"
                                                                            TextTrimming="CharacterEllipsis" />
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                </Grid>

                                                <ItemsControl ItemsSource="{Binding Rows}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="410" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>

                                                                <Grid
                                                                    Grid.Column="0"
                                                                    Height="34"
                                                                    Background="{Binding State, Converter={StaticResource RecordComparisonValueBackgroundBrushConverter}}"
                                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                    BorderThickness="1,0,0,1">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="160" />
                                                                    </Grid.ColumnDefinitions>

                                                                    <TextBlock
                                                                        Grid.Column="0"
                                                                        Padding="8,5"
                                                                        Text="{Binding Label}"
                                                                        TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock
                                                                        Grid.Column="1"
                                                                        Padding="8,5"
                                                                        Text="{Binding Type}"
                                                                        TextTrimming="CharacterEllipsis" />
                                                                </Grid>

                                                                <ScrollViewer
                                                                    Grid.Column="1"
                                                                    HorizontalScrollBarVisibility="Auto"
                                                                    HorizontalScrollMode="Enabled"
                                                                    VerticalScrollMode="Disabled">
                                                                    <ItemsControl ItemsSource="{Binding Values}">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <StackPanel Orientation="Horizontal" />
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <Border
                                                                                    Width="280"
                                                                                    Height="34"
                                                                                    Background="{Binding State, Converter={StaticResource RecordComparisonValueBackgroundBrushConverter}}"
                                                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                                    BorderThickness="0,0,1,1"
                                                                                    Padding="8,5">
                                                                                    <TextBlock
                                                                                        Text="{Binding Value}"
                                                                                        TextTrimming="CharacterEllipsis" />
                                                                                </Border>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </ScrollViewer>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border
            Grid.Row="1"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            Padding="12,8">
            <ScrollViewer
                HorizontalScrollBarVisibility="Auto"
                HorizontalScrollMode="Enabled"
                VerticalScrollMode="Disabled">
                <Grid
                    MinWidth="1120"
                    ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="18">
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{Binding ImportedRecordCountText}" />
                        <Rectangle
                            Width="1"
                            Height="22"
                            Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{Binding ActiveRecordCountText}" />
                        <Rectangle
                            Width="1"
                            Height="22"
                            Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{Binding ActivePluginText}" />
                        <Rectangle
                            Width="1"
                            Height="22"
                            Fill="{ThemeResource CardStrokeColorDefaultBrush}"
                            Visibility="{Binding SelectedRecordContextVisibility}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{Binding SelectedRecordContextText}"
                            Visibility="{Binding SelectedRecordContextVisibility}" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="22">
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="6">
                            <Border
                                Width="16"
                                Height="16"
                                Background="#50008000" />
                            <TextBlock Text="Identical" />
                        </StackPanel>
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="6">
                            <Border
                                Width="16"
                                Height="16"
                                Background="#50C00000" />
                            <TextBlock Text="Conflict" />
                        </StackPanel>
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="6">
                            <Border
                                Width="16"
                                Height="16"
                                Background="#50C0A000" />
                            <TextBlock Text="Winning Override" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
