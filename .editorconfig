root = true

[*]
indent_style = space
indent_size = 4
tab_width = 4


[*.md]
indent_style = space
indent_size = 2
tab_width = 2
max_line_length = 120

[*.cs]
indent_style = space
indent_size = 4
tab_width = 4
max_line_length = 400

[*.sql]
indent_style = space
indent_size = 4
tab_width = 4
max_line_length = 400

# Allow single-line control statements without braces
csharp_prefer_braces = false:none

# Disable use primary constructors
dotnet_diagnostic.IDE0290.severity = none