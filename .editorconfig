root = true

[*]
indent_style = space
indent_size = 4
tab_width = 4

[*.yml]
[*.yaml]
indent_style = space
indent_size = 2
tab_width = 2

[*.md]
indent_style = space
indent_size = 2
tab_width = 2
max_line_length = 120

[*.sql]
indent_style = space
indent_size = 4
tab_width = 4
max_line_length = 400

[*.cs]
indent_style = space
indent_size = 4
tab_width = 4
max_line_length = 400

# Do not suggest C# primary constructors.
dotnet_diagnostic.IDE0290.severity = none