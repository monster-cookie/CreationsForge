{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug GUI <All>",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/CreationsForge/bin/Debug/net10.0/CreationsForge.exe",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false,
      "env": {
        "DOTNET_ENVIRONMENT": "Development"
      },
      "preLaunchTask": "build"
    },
    {
      "name": "Debug MCP",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/CreationsForge.Mcp/bin/Debug/net10.0/CreationsForge.Mcp.dll",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false,
      "env": {
        "DOTNET_ENVIRONMENT": "Development"
      },
      "preLaunchTask": "build"
    }
  ]
}
