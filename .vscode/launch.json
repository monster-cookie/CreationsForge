{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug GUI <All>",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/CreationsForge/bin/Debug/net10.0/CreationsForge.exe",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false,
      "env": {
        "DOTNET_ENVIRONMENT": "Development"
      },
      "preLaunchTask": "build"
    },
    {
      "name": "Debug CLI <Starfield>",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/CreationsForge.Console/bin/Debug/net10.0/CreationsForge.Console.dll",
      "args": [
        "--game",
        "Starfield"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false,
      "env": {
        "DOTNET_ENVIRONMENT": "Development"
      },
      "preLaunchTask": "build"
    },
    {
      "name": "Debug CLI <Fallout>",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/CreationsForge.Console/bin/Debug/net10.0/CreationsForge.Console.dll",
      "args": [
        "--game",
        "Fallout4"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false,
      "env": {
        "DOTNET_ENVIRONMENT": "Development"
      },
      "preLaunchTask": "build"
    },
    {
      "name": "Debug CLI <Skyrim>",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/CreationsForge.Console/bin/Debug/net10.0/CreationsForge.Console.dll",
      "args": [
        "--game",
        "Skyrim"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false,
      "env": {
        "DOTNET_ENVIRONMENT": "Development"
      },
      "preLaunchTask": "build"
    }
  ]
}
