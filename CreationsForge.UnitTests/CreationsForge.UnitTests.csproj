<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <NoWarn>$(NoWarn);xUnit1051</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.collector" Version="10.0.1">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
        <PackageReference Include="Moq" Version="4.20.72" />
        <PackageReference Include="Shouldly" Version="4.3.0" />
        <PackageReference Include="xunit.v3" Version="4.0.1" />
        <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\CreationsForge.Mcp\CreationsForge.Mcp.csproj" />
        <ProjectReference Include="..\CreationsForge.Bethesda.Assets\CreationsForge.Bethesda.Assets.csproj" />
        <ProjectReference Include="..\CreationsForge.Core\CreationsForge.Core.csproj" />
        <ProjectReference Include="..\CreationsForge.Fallout4\CreationsForge.Fallout4.csproj" />
        <ProjectReference Include="..\CreationsForge.Skyrim\CreationsForge.Skyrim.csproj" />
        <ProjectReference Include="..\CreationsForge.Starfield\CreationsForge.Starfield.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="..\CreationsForge.Starfield\PluginAdapter\RecordInspection\Nested\StarfieldRecordFieldManifest.json" LogicalName="CreationsForge.Starfield.RecordFieldManifest.json" />
        <EmbeddedResource Include="..\CreationsForge.Starfield\PluginAdapter\RecordInspection\MajorRecords\StarfieldMajorRecordCoverage.json" LogicalName="CreationsForge.Starfield.MajorRecordCoverage.json" />
        <EmbeddedResource Include="..\CreationsForge.Fallout4\PluginAdapter\RecordInspection\MajorRecords\Fallout4MajorRecordCoverage.json" LogicalName="CreationsForge.Fallout4.MajorRecordCoverage.json" />
        <EmbeddedResource Include="..\CreationsForge.Skyrim\PluginAdapter\RecordInspection\MajorRecords\SkyrimMajorRecordCoverage.json" LogicalName="CreationsForge.Skyrim.MajorRecordCoverage.json" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\TestSupport\McpStdioProcessFixture.cs" Link="TestSupport\McpStdioProcessFixture.cs" />
    </ItemGroup>

</Project>
