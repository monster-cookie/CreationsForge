<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CreationsForge.Workbench"
        x:Class="CreationsForge.Workbench.MainWindow"
        x:DataType="vm:WorkbenchViewModel"
        Title="CreationsForge MCP Workbench"
        Width="900"
        Height="860"
        MinWidth="720"
        MinHeight="560">
  <ScrollViewer>
    <StackPanel Margin="24" Spacing="16">
      <StackPanel Spacing="4">
        <TextBlock FontSize="26" FontWeight="Bold">MCP Workbench</TextBlock>
        <TextBlock TextWrapping="Wrap">A standalone developer shell for the production CreationsForge MCP host. Connect negotiates the protocol and lists tools. The guided authoring pane creates, overrides, compares, saves, and reopens records through those tools.</TextBlock>
      </StackPanel>

      <Border BorderBrush="#606060" BorderThickness="1" CornerRadius="4" Padding="16">
        <StackPanel Spacing="12">
          <TextBlock FontSize="18" FontWeight="SemiBold">Connection</TextBlock>
          <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="10">
            <TextBlock Grid.Row="0" VerticalAlignment="Center">MCP executable</TextBlock>
            <TextBox Grid.Row="0" Grid.Column="1" Name="ExecutablePathTextBox" Text="{Binding McpExecutablePath}" PlaceholderText="Path to CreationsForge.Mcp.dll or executable" IsEnabled="{Binding CanConnect}" />
            <Button Grid.Row="0" Grid.Column="2" Click="BrowseExecutableClick" IsEnabled="{Binding CanConnect}">Browse</Button>
            <TextBlock Grid.Row="1" VerticalAlignment="Center">Game release</TextBlock>
            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Releases}" SelectedItem="{Binding Release}" IsEnabled="{Binding CanEditSources}" />
            <TextBlock Grid.Row="2" VerticalAlignment="Center">Data directory</TextBlock>
            <TextBox Grid.Row="2" Grid.Column="1" Name="DataDirectoryTextBox" Text="{Binding DataDirectory}" PlaceholderText="Directory containing selected source plugins" IsEnabled="{Binding CanEditSources}" />
            <Button Grid.Row="2" Grid.Column="2" Click="BrowseDataDirectoryClick" IsEnabled="{Binding CanEditSources}">Browse</Button>
            <TextBlock Grid.Row="3" VerticalAlignment="Center">Source plugins</TextBlock>
            <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding SelectedPlugins}" PlaceholderText="Optional comma-separated plugin names, low to high priority" IsEnabled="{Binding CanEditSources}" />
            <TextBlock Grid.Row="4" VerticalAlignment="Center">Status</TextBlock>
            <StackPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Spacing="4">
              <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding ActivityText}" IsVisible="{Binding HasActivity}" TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Click="ConnectClick" IsEnabled="{Binding CanConnect}">Connect</Button>
            <Button Click="CancelClick" IsEnabled="{Binding CanCancel}">Cancel</Button>
            <Button Click="DisconnectClick" IsEnabled="{Binding CanDisconnect}">Disconnect</Button>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border BorderBrush="#606060" BorderThickness="1" CornerRadius="4" Padding="16">
        <StackPanel Spacing="12">
          <TextBlock FontSize="18" FontWeight="SemiBold">Workspace output</TextBlock>
          <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="10">
            <TextBlock Grid.Row="0" VerticalAlignment="Center">Output path</TextBlock>
            <TextBox Grid.Row="0" Grid.Column="1" Name="OutputPathTextBox" Text="{Binding OutputPath}" PlaceholderText="Explicit output plugin path" IsEnabled="{Binding CanEditOutput}" />
            <Button Grid.Row="0" Grid.Column="2" Click="BrowseOutputClick" IsEnabled="{Binding CanEditOutput}">Browse</Button>
            <TextBlock Grid.Row="1" VerticalAlignment="Center">Master style</TextBlock>
            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding MasterStyles}" SelectedItem="{Binding MasterStyle}" IsEnabled="{Binding CanEditOutput}" />
            <TextBlock Grid.Row="2" VerticalAlignment="Center">Text storage</TextBlock>
            <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding TextStorageModes}" SelectedItem="{Binding TextStorageMode}" IsEnabled="{Binding CanEditOutput}" />
            <TextBlock Grid.Row="3" VerticalAlignment="Center">Language</TextBlock>
            <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" IsEnabled="{Binding CanEditOutput}" />
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Click="OpenWorkspaceClick" IsEnabled="{Binding CanOpenWorkspace}">Open workspace</Button>
            <Button Click="CreateOutputClick" IsEnabled="{Binding CanCreateOutput}">Create output</Button>
            <Button Click="OpenOutputClick" IsEnabled="{Binding CanOpenOutput}">Open output</Button>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border BorderBrush="#606060" BorderThickness="1" CornerRadius="4" Padding="16">
        <StackPanel Spacing="12">
          <TextBlock FontSize="18" FontWeight="SemiBold">Guided authoring</TextBlock>
          <TextBlock TextWrapping="Wrap">Find, create, or override a record, then Apply. Apply stays in memory. Save writes the output. Reopen starts a new MCP process and reads the file back. Validation, save, and discard failures stay on this screen and do not report a save.</TextBlock>
          <TextBlock Text="{Binding PublishedPathText}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding AuthoringModeText}" TextWrapping="Wrap" />
          <TextBlock Text="Unsaved edits are not on disk." IsVisible="{Binding HasUnsavedEdits}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="Text storage" />
            <TextBlock Text="{Binding TextStorageMode}" FontWeight="SemiBold" />
            <TextBlock Text="language" />
            <TextBlock Text="{Binding Language}" FontWeight="SemiBold" />
          </StackPanel>
          <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
            <TextBlock Grid.Row="0" VerticalAlignment="Center">Family</TextBlock>
            <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Families}" SelectedItem="{Binding SelectedFamily}" IsEnabled="{Binding CanFindRecords}" />
            <TextBlock Grid.Row="1" VerticalAlignment="Center">EditorID filter</TextBlock>
            <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding EditorIdFilter}" PlaceholderText="Optional EditorID filter" IsEnabled="{Binding CanFindRecords}" />
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Click="FindRecordsClick" IsEnabled="{Binding CanFindRecords}">Find record</Button>
            <Button Click="NewRecordClick" IsEnabled="{Binding CanCreateRecord}">New</Button>
            <Button Click="OverrideRecordClick" IsEnabled="{Binding CanOverrideRecord}">Override</Button>
          </StackPanel>
          <ListBox ItemsSource="{Binding SearchHits}" SelectedItem="{Binding SelectedHit}" MaxHeight="140">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:WorkbenchRecordHit">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <ScrollViewer MaxHeight="360" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Fields}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:WorkbenchFieldDraft">
                  <Border BorderBrush="#404040" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                    <StackPanel Spacing="6">
                      <TextBlock FontWeight="SemiBold" Text="{Binding Path}" />
                      <TextBlock Text="{Binding UnsupportedReason}" IsVisible="{Binding IsUnsupported}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding ReferenceSummary}" IsVisible="{Binding HasReferenceSummary}" TextWrapping="Wrap" />
                      <CheckBox Content="Clear value" IsChecked="{Binding ClearValue}" IsVisible="{Binding CanClear}" />
                      <TextBox Text="{Binding StringValue}" IsVisible="{Binding IsString}" />
                      <CheckBox Content="Value" IsChecked="{Binding BooleanValue}" IsVisible="{Binding IsBoolean}" />
                      <TextBox Text="{Binding NumberText}" IsVisible="{Binding IsNumber}" />
                      <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding EnumValue}" IsVisible="{Binding IsEnum}" />
                      <ItemsControl ItemsSource="{Binding Flags}" IsVisible="{Binding IsFlagsEnum}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:WorkbenchFlagChoice">
                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBox Text="{Binding FormKeyText}" PlaceholderText="FormKey, such as 000001:Source.esm" IsVisible="{Binding IsFormLink}" />
                      <StackPanel Spacing="6" IsVisible="{Binding IsTranslated}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                          <TextBlock VerticalAlignment="Center">Target language</TextBlock>
                          <ComboBox Grid.Column="1" ItemsSource="{Binding Languages}" SelectedItem="{Binding TargetLanguage}" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Translations}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:WorkbenchTranslationRow">
                              <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8" Margin="0,0,0,6">
                                <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" />
                                <TextBox Grid.Column="1" Text="{Binding Value}" />
                                <Button Grid.Column="2" Content="Remove" Click="RemoveTranslationClick" />
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="Add language" Click="AddTranslationClick" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Click="ApplyRecordClick" IsEnabled="{Binding CanApplyRecord}">Apply</Button>
            <Button Click="CompareRecordClick" IsEnabled="{Binding CanCompareRecord}">Compare</Button>
            <Button Click="PreviewChangesClick" IsEnabled="{Binding CanPreviewChanges}">Preview</Button>
            <Button Click="SaveChangesClick" IsEnabled="{Binding CanSaveChanges}">Save</Button>
            <Button Click="DiscardChangesClick" IsEnabled="{Binding CanDiscardChanges}">Discard</Button>
            <Button Click="ReopenFreshClick" IsEnabled="{Binding CanReopenFresh}">Reopen in a fresh session</Button>
          </StackPanel>
          <TextBox Text="{Binding Observations}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" />
        </StackPanel>
      </Border>

      <Border BorderBrush="#606060" BorderThickness="1" CornerRadius="4" Padding="16">
        <StackPanel Spacing="8">
          <TextBlock FontSize="18" FontWeight="SemiBold">Discovered tools</TextBlock>
          <TextBlock Text="{Binding DiscoverySummary}" TextWrapping="Wrap" />
          <Grid ColumnDefinitions="280,*" ColumnSpacing="12">
            <ListBox ItemsSource="{Binding DiscoveredTools}" SelectedItem="{Binding SelectedTool}" MaxHeight="180">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:WorkbenchMcpTool">
                  <TextBlock Text="{Binding Name}" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Column="1" Spacing="8">
              <TextBlock Text="{Binding SelectedToolDescription}" TextWrapping="Wrap" />
              <TextBox Text="{Binding SelectedToolSchema}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <Border BorderBrush="#606060" BorderThickness="1" CornerRadius="4" Padding="16">
        <StackPanel Spacing="8">
          <TextBlock FontSize="18" FontWeight="SemiBold">Diagnostics</TextBlock>
          <TextBlock Text="{Binding LogFilePath}" IsVisible="{Binding HasLogFile}" TextWrapping="Wrap" />
          <TextBox Text="{Binding Diagnostics}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="150" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Window>
